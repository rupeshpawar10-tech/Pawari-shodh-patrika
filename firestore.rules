rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Pages collection
    match /pages/{pageId} {
      allow read, write: if true;
    }

    // Homepage sections layout config
    match /homepage_sections/{sectionId} {
      allow read, write: if true;
    }

    // Articles collection
    match /articles/{articleId} {
      allow read, write: if true;
    }

    // Issues collection
    match /issues/{issueId} {
      allow read, write: if true;
    }

    // Editorial Board collections
    match /editorial_board/{memberId} {
      allow read, write: if true;
    }

    match /editorial_members/{memberId} {
      allow read, write: if true;
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Contact Messages
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    // Submissions
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // Roles collection
    match /roles/{roleId} {
      allow read, write: if true;
    }

    // Media Library
    match /media/{mediaId} {
      allow read, write: if true;
    }

    // Books collection
    match /books/{bookId} {
      allow read, write: if true;
    }

    // Blogs collection
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // User Files collection (Base64 file storage in Firestore)
    match /user_files/{fileId} {
      allow read, write: if true;
    }

    // Users Collection (RBAC Profiles)
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
