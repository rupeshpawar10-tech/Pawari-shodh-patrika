rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email == 'rupeshpawar10@gmail.com' ||
          getUserData().role == 'super_admin' || 
          getUserData().role == 'director' || 
          getUserData().role == 'editor' || 
          getUserData().role == 'editorial' || 
          getUserData().role == 'admin' ||
          request.auth.token.admin == true
        );
    }

    // Journal Settings & Configuration - Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Custom CMS System Roles - Public read, Staff write
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Research Articles collection - Public read, Staff write
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Issues & Volumes collection - Public read, Staff write
    match /issues/{issueId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Editorial Board & Members - Public read, Staff write
    match /editorial_board/{memberId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /editorial_members/{memberId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Announcements & Press Releases - Public read, Staff write
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Contact Messages - Public create, Staff read/manage
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isStaffOrAdmin();
    }

    // Author Manuscript Submissions - Public create, Author/Staff read
    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if isStaffOrAdmin() || (isAuthenticated() && resource.data.author_email == request.auth.token.email);
      allow update, delete: if isStaffOrAdmin();
    }

    // Books, Monographs & Publications - Public read, Staff write
    match /books/{bookId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Pawari Cultural Repositories (Shabdkosh, Paheli, Lokgeet, Quiz)
    match /shabdkosh/{shabdkoshId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /paheli/{paheliId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /lokgeet/{lokgeetId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /quiz_certificates/{certId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // Public Community Contributions - Public create, Staff manage
    match /public_contributions/{contribId} {
      allow create: if true;
      allow read, update, delete: if isStaffOrAdmin();
    }

    // Activity Logs - Staff read/create only
    match /activity_logs/{logId} {
      allow read, create: if isStaffOrAdmin();
      allow update, delete: if false;
    }

    // User Profiles collection - User read own profile, Staff full manage
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaffOrAdmin());
      allow write: if isStaffOrAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Base64 & Uploaded user files fallback
    match /user_files/{fileId} {
      allow read: if true;
      allow write: if isStaffOrAdmin() || isAuthenticated();
    }
  }
}
