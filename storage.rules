rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)');
    }

    function isDocument() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|octet-stream)');
    }

    // User folder rules: users/{uid}/images/{filename}
    match /users/{uid}/images/{fileName} {
      allow read: if true;
      allow write, create, update: if request.resource.size <= 15 * 1024 * 1024;
      allow delete: if true;
    }

    // User folder rules: users/{uid}/documents/{filename}
    match /users/{uid}/documents/{fileName} {
      allow read: if true;
      allow write, create, update: if request.resource.size <= 25 * 1024 * 1024;
      allow delete: if true;
    }

    // Editorial and general public uploads (Admin & system features)
    match /editorial_photos/{fileName} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    match /documents/{fileName} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    match /manuscripts/{fileName} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    match /books/{fileName} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    match /media/{fileName} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    // Catch-all rule for all other storage paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size <= 25 * 1024 * 1024;
    }
  }
}

